<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════════════
         LibreScan Security — Premium Dark Theme
         Color palette inspired by GitHub Dark / Vercel
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- ─── Backgrounds ──────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="BgDeepBrush"    Color="#0d1117"/>
    <SolidColorBrush x:Key="BgBaseBrush"    Color="#161b22"/>
    <SolidColorBrush x:Key="BgOverlayBrush" Color="#21262d"/>
    <SolidColorBrush x:Key="BgHoverBrush"   Color="#272d38"/>
    <SolidColorBrush x:Key="BgActiveBrush"  Color="#1c2433"/>

    <!-- ─── Borders ──────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="#30363d"/>
    <SolidColorBrush x:Key="BorderMutedBrush"   Color="#21262d"/>

    <!-- ─── Text ─────────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#e6edf3"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8b949e"/>
    <SolidColorBrush x:Key="TextMutedBrush"     Color="#484f58"/>

    <!-- ─── Accent Colors ────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="AccentTealBrush"    Color="#2dd4bf"/>
    <SolidColorBrush x:Key="AccentEmeraldBrush" Color="#10b981"/>
    <SolidColorBrush x:Key="AccentBlueBrush"    Color="#58a6ff"/>
    <SolidColorBrush x:Key="AccentAmberBrush"   Color="#d29922"/>
    <SolidColorBrush x:Key="AccentRedBrush"     Color="#f85149"/>
    <SolidColorBrush x:Key="AccentGreenBrush"   Color="#3fb950"/>

    <!-- ─── Gradient Brushes ─────────────────────────────────────────────── -->
    <LinearGradientBrush x:Key="TealGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2dd4bf" Offset="0"/>
        <GradientStop Color="#10b981" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BlueGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#58a6ff" Offset="0"/>
        <GradientStop Color="#1f6feb" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="EmeraldGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3fb950" Offset="0"/>
        <GradientStop Color="#238636" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AmberGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#d29922" Offset="0"/>
        <GradientStop Color="#bb8009" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RedGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#f85149" Offset="0"/>
        <GradientStop Color="#da3633" Offset="1"/>
    </LinearGradientBrush>

    <!-- ─── Shield Path Geometries ───────────────────────────────────────── -->
    <Geometry x:Key="ShieldGeometry">M 24,2 L 44,10 L 44,24 C 44,36 35,44 24,47 C 13,44 4,36 4,24 L 4,10 Z</Geometry>
    <Geometry x:Key="CheckGeometry">M 14,24 L 20,30 L 34,16</Geometry>

    <!-- ─── Converters ───────────────────────────────────────────────────── -->
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <!-- ═══════════════════════════════════════════════════════════════════════
         Navigation Item  (RadioButton re-templated as sidebar nav link)
         ═══════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="NavItemStyle" TargetType="RadioButton">
        <Setter Property="GroupName" Value="Navigation"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="NavBg" Background="Transparent"
                            CornerRadius="8" Padding="16,11">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="Icon"
                                       Text="{TemplateBinding Tag}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="16" Foreground="#484f58"
                                       VerticalAlignment="Center"
                                       Margin="0,0,14,0"/>
                            <TextBlock x:Name="Label"
                                       Text="{TemplateBinding Content}"
                                       FontSize="14" FontWeight="Medium"
                                       Foreground="#8b949e"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="NavBg"  Property="Background" Value="#1c2433"/>
                            <Setter TargetName="Icon"   Property="Foreground" Value="#2dd4bf"/>
                            <Setter TargetName="Label"  Property="Foreground" Value="#e6edf3"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked"   Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="NavBg"  Property="Background" Value="#1a2030"/>
                            <Setter TargetName="Label"  Property="Foreground" Value="#c9d1d9"/>
                            <Setter TargetName="Icon"   Property="Foreground" Value="#6e7681"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         Action Card  (Button with scale-on-hover micro-animation)
         ═══════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="ActionCardStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Card" Background="#21262d"
                            CornerRadius="12" Padding="24,22"
                            BorderBrush="#30363d" BorderThickness="1"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="CardScale"/>
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover: subtle scale + border highlight -->
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="CardScale"
                                                     Storyboard.TargetProperty="ScaleX"
                                                     To="1.03" Duration="0:0:0.15">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="CardScale"
                                                     Storyboard.TargetProperty="ScaleY"
                                                     To="1.03" Duration="0:0:0.15">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="CardScale"
                                                     Storyboard.TargetProperty="ScaleX"
                                                     To="1.0" Duration="0:0:0.15"/>
                                    <DoubleAnimation Storyboard.TargetName="CardScale"
                                                     Storyboard.TargetProperty="ScaleY"
                                                     To="1.0" Duration="0:0:0.15"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="#3d444d"/>
                            <Setter TargetName="Card" Property="Background"  Value="#272d38"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Card" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         Primary Button  (teal gradient, pill-shaped)
         ═══════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="20,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            Background="{StaticResource TealGradient}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         Danger Button  (red gradient)
         ═══════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="DangerButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="20,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            Background="{StaticResource RedGradient}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         Ghost Button  (transparent with border, for secondary actions)
         ═══════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="GhostButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="#8b949e"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            BorderBrush="#30363d" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background"  Value="#21262d"/>
                            <Setter Property="Foreground" Value="#e6edf3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         Thin Dark ScrollBar  (replaces default Windows chrome)
         ═══════════════════════════════════════════════════════════════════════ -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid x:Name="Root" SnapsToDevicePixels="True">
                        <Track x:Name="PART_Track"
                               IsDirectionReversed="True"
                               IsEnabled="{TemplateBinding IsMouseOver}">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Style>
                                        <Style TargetType="Thumb">
                                            <Setter Property="OverridesDefaultStyle" Value="True"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border x:Name="ThumbBg"
                                                                Background="#30363d"
                                                                CornerRadius="4" Margin="1"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ThumbBg"
                                                                        Property="Background"
                                                                        Value="#484f58"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Thumb.Style>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track"
                                    Property="IsDirectionReversed" Value="False"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width"    Value="8"/>
                <Setter Property="MinWidth" Value="8"/>
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height"    Value="8"/>
                <Setter Property="MinHeight" Value="8"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
