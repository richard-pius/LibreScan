<Window x:Class="LibreScan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LibreScan.ViewModels"
        Title="LibreScan Security"
        Height="720" Width="1080" MinHeight="600" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDeepBrush}">

    <!-- ═══════════════════════════════════════════════════════════════════════
         LibreScan Security — Premium Dark-Mode Dashboard
         ═══════════════════════════════════════════════════════════════════════ -->

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ SIDEBAR ═══════════════════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="{StaticResource BgBaseBrush}"
                BorderBrush="{StaticResource BorderDefaultBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- App Branding -->
                <StackPanel DockPanel.Dock="Top" Margin="24,28,24,36">
                    <Viewbox Width="40" Height="40" HorizontalAlignment="Left">
                        <Canvas Width="48" Height="49">
                            <Path Data="{StaticResource ShieldGeometry}"
                                  Fill="{StaticResource TealGradient}"/>
                            <Path Data="{StaticResource CheckGeometry}"
                                  Stroke="White" StrokeThickness="3.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Margin="0,14,0,0" LineHeight="26">
                        <Run Text="LibreScan" FontSize="22" FontWeight="Bold"
                             Foreground="{StaticResource TextPrimaryBrush}"/>
                        <LineBreak/>
                        <Run Text="Security" FontSize="22" FontWeight="Light"
                             Foreground="{StaticResource AccentTealBrush}"/>
                    </TextBlock>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel DockPanel.Dock="Top" Margin="12,0">
                    <TextBlock Text="M E N U" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="16,0,0,10"/>

                    <RadioButton x:Name="NavDashboard"
                                 Style="{StaticResource NavItemStyle}"
                                 Content="Dashboard" Tag="&#xE80F;"
                                 IsChecked="True"
                                 Checked="NavDashboard_Checked"/>
                    <RadioButton x:Name="NavQuarantine"
                                 Style="{StaticResource NavItemStyle}"
                                 Content="Quarantine" Tag="&#xE7B8;"
                                 Checked="NavQuarantine_Checked"/>
                </StackPanel>

                <!-- Bottom Panel: DB info -->
                <Border DockPanel.Dock="Bottom"
                        Background="#1c2433" CornerRadius="10"
                        Padding="16,14" Margin="16,0,16,20"
                        VerticalAlignment="Bottom">
                    <StackPanel>
                        <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}">
                            <Run Text="Definitions:"/>
                        </TextBlock>
                        <TextBlock Text="{Binding DatabaseDate}"
                                   FontSize="12" FontWeight="Medium"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,4,0,0"/>
                        <TextBlock Text="v1.0.0" FontSize="10"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

            </DockPanel>
        </Border>

        <!-- ═══ MAIN CONTENT AREA ═════════════════════════════════════════════ -->
        <Grid Grid.Column="1">

            <!-- ─── Dashboard Panel ─────────────────────────────────────────── -->
            <Grid x:Name="DashboardPanel">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="32,28,32,24">

                        <!-- ── Status Hero Card ──────────────────────────────── -->
                        <Border Background="{StaticResource BgOverlayBrush}"
                                CornerRadius="16" Padding="32,28"
                                BorderBrush="{StaticResource BorderDefaultBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Shield with pulsing glow -->
                                <Grid Grid.Column="0" Margin="0,0,28,0"
                                      VerticalAlignment="Center">
                                    <!-- Glow ring -->
                                    <Ellipse Width="80" Height="80" Margin="-8">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Opacity" Value="0.12"/>
                                                <Setter Property="Fill">
                                                    <Setter.Value>
                                                        <RadialGradientBrush>
                                                            <GradientStop Color="#2dd4bf" Offset="0"/>
                                                            <GradientStop Color="Transparent" Offset="1"/>
                                                        </RadialGradientBrush>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <!-- Pulse animation while busy -->
                                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard x:Name="PulseBegin">
                                                                <Storyboard RepeatBehavior="Forever">
                                                                    <DoubleAnimation
                                                                        Storyboard.TargetProperty="Opacity"
                                                                        From="0.1" To="0.5"
                                                                        Duration="0:0:1.2"
                                                                        AutoReverse="True">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <SineEase EasingMode="EaseInOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <StopStoryboard BeginStoryboardName="PulseBegin"/>
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                    <!-- Red glow on danger -->
                                                    <DataTrigger Binding="{Binding CurrentStatus}" Value="{x:Static vm:StatusLevel.Danger}">
                                                        <Setter Property="Fill">
                                                            <Setter.Value>
                                                                <RadialGradientBrush>
                                                                    <GradientStop Color="#f85149" Offset="0"/>
                                                                    <GradientStop Color="Transparent" Offset="1"/>
                                                                </RadialGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>

                                    <!-- Shield icon -->
                                    <Viewbox Width="52" Height="52">
                                        <Canvas Width="48" Height="49">
                                            <Path Data="{StaticResource ShieldGeometry}">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Fill" Value="{StaticResource TealGradient}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CurrentStatus}" Value="{x:Static vm:StatusLevel.Danger}">
                                                                <Setter Property="Fill" Value="{StaticResource RedGradient}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding CurrentStatus}" Value="{x:Static vm:StatusLevel.Warning}">
                                                                <Setter Property="Fill" Value="{StaticResource AmberGradient}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding CurrentStatus}" Value="{x:Static vm:StatusLevel.Error}">
                                                                <Setter Property="Fill" Value="{StaticResource RedGradient}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <Path Data="{StaticResource CheckGeometry}"
                                                  Stroke="White" StrokeThickness="3.5"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                </Grid>

                                <!-- Status Text -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusText}"
                                               FontSize="24" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding StatusSubtext}"
                                               FontSize="13" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,6,0,0"/>
                                </StackPanel>

                                <!-- Cancel button (visible only when busy) -->
                                <Button Grid.Column="2"
                                        Content="Cancel"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Command="{Binding CancelCommand}"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                        VerticalAlignment="Center"
                                        Padding="18,9"/>
                            </Grid>
                        </Border>

                        <!-- ── Scan Statistics (visible during scan) ─────────── -->
                        <Border Background="{StaticResource BgOverlayBrush}"
                                CornerRadius="12" Padding="24,18"
                                BorderBrush="{StaticResource BorderDefaultBrush}"
                                BorderThickness="1" Margin="0,16,0,0"
                                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                            <UniformGrid Columns="3">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="ELAPSED" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding ElapsedTime}" FontSize="22"
                                               FontWeight="Bold" FontFamily="Cascadia Code, Consolas"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="FILES SCANNED" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding FilesScannedCount}" FontSize="22"
                                               FontWeight="Bold" FontFamily="Cascadia Code, Consolas"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="THREATS" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding ThreatsFoundCount}" FontSize="22"
                                               FontWeight="Bold" FontFamily="Cascadia Code, Consolas"
                                               Foreground="{StaticResource AccentRedBrush}"
                                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                            </UniformGrid>
                        </Border>

                        <!-- ── Detected Threats Panel ────────────────────────── -->
                        <Border Background="#1a1520" CornerRadius="12" Padding="20,16"
                                BorderBrush="#3d2030" BorderThickness="1"
                                Margin="0,12,0,0"
                                Visibility="{Binding HasThreats, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock Text="⚠ Detected Threats" FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentRedBrush}"
                                               VerticalAlignment="Center"/>
                                    <Button Content="Quarantine All"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Command="{Binding QuarantineAllCommand}"
                                            DockPanel.Dock="Right"
                                            HorizontalAlignment="Right"
                                            Padding="16,8" FontSize="12"/>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding DetectedThreats}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#21161d" CornerRadius="8"
                                                    Padding="14,10" Margin="0,3">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right"
                                                               Text="{Binding ThreatName}"
                                                               Foreground="{StaticResource AccentRedBrush}"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               Margin="12,0,0,0"/>
                                                    <TextBlock Text="{Binding FilePath}"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="12" TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- ── Action Cards (2 × 2 grid) ─────────────────────── -->
                        <UniformGrid Columns="4" Margin="-6,14,-6,0">

                            <!-- Quick Scan -->
                            <Button Style="{StaticResource ActionCardStyle}"
                                    Command="{Binding QuickScanCommand}">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Background="#0f2d2a" CornerRadius="12"
                                            Width="48" Height="48" Margin="0,0,0,14">
                                        <TextBlock Text="&#xE945;"
                                                   FontFamily="Segoe MDL2 Assets" FontSize="20"
                                                   Foreground="#2dd4bf"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Quick Scan" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Critical folders" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>

                            <!-- Full Scan -->
                            <Button Style="{StaticResource ActionCardStyle}"
                                    Command="{Binding FullScanCommand}">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Background="#0f1d2d" CornerRadius="12"
                                            Width="48" Height="48" Margin="0,0,0,14">
                                        <TextBlock Text="&#xE721;"
                                                   FontFamily="Segoe MDL2 Assets" FontSize="20"
                                                   Foreground="#58a6ff"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Full Scan" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="All drives" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>

                            <!-- Update Definitions -->
                            <Button Style="{StaticResource ActionCardStyle}"
                                    Command="{Binding UpdateCommand}">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Background="#0f2d1f" CornerRadius="12"
                                            Width="48" Height="48" Margin="0,0,0,14">
                                        <TextBlock Text="&#xE72C;"
                                                   FontFamily="Segoe MDL2 Assets" FontSize="20"
                                                   Foreground="#3fb950"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Update" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Virus definitions" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>

                            <!-- Quarantine -->
                            <Button Style="{StaticResource ActionCardStyle}"
                                    Click="GoToQuarantine_Click">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Background="#2d1f0f" CornerRadius="12"
                                            Width="48" Height="48" Margin="0,0,0,14">
                                        <TextBlock Text="&#xE7B8;"
                                                   FontFamily="Segoe MDL2 Assets" FontSize="20"
                                                   Foreground="#d29922"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Quarantine" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0">
                                        <Run Text="{Binding QuarantineEntries.Count, Mode=OneWay}"/>
                                        <Run Text=" items"/>
                                    </TextBlock>
                                </StackPanel>
                            </Button>

                        </UniformGrid>

                        <!-- ── Activity Log ──────────────────────────────────── -->
                        <Border Background="{StaticResource BgOverlayBrush}"
                                CornerRadius="12"
                                BorderBrush="{StaticResource BorderDefaultBrush}"
                                BorderThickness="1" Margin="0,20,0,0"
                                MaxHeight="220">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top"
                                           Text="Activity Log" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="18,16,18,8"/>
                                <ListBox x:Name="LogListBox"
                                         ItemsSource="{Binding LogEntries}"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource TextMutedBrush}"
                                         FontFamily="Cascadia Code, Consolas, Courier New"
                                         FontSize="11.5"
                                         Padding="14,0,14,14"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="False">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,1"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Focusable" Value="False"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </DockPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ─── Quarantine Panel ────────────────────────────────────────── -->
            <Grid x:Name="QuarantinePanel" Visibility="Collapsed">
                <DockPanel Margin="32,28,32,24">

                    <!-- Header -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                        <TextBlock Text="Quarantine" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,6,0,0">
                            <Run Text="Isolated threats: "/>
                            <Run Text="{Binding QuarantineEntries.Count, Mode=OneWay}"
                                 FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Empty state -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding QuarantineEntries.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="48" Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="Quarantine is empty"
                                   FontSize="16" Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Detected threats will appear here after scanning"
                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Quarantine List -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding QuarantineEntries.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <ItemsControl ItemsSource="{Binding QuarantineEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgOverlayBrush}"
                                            CornerRadius="10" Padding="20,16"
                                            BorderBrush="{StaticResource BorderDefaultBrush}"
                                            BorderThickness="1" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                <TextBlock Text="{Binding OriginalFileName}"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding ThreatName}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource AccentRedBrush}"
                                                           Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding OriginalPath}"
                                                           FontSize="11" TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           Margin="0,4,0,0"/>
                                                <TextBlock FontSize="10"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           Margin="0,4,0,0">
                                                    <Run Text="Quarantined: "/>
                                                    <Run Text="{Binding QuarantinedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}', Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Button Content="Restore"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Command="{Binding DataContext.RestoreCommand,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Margin="0,0,8,0"/>
                                                <Button Content="Delete"
                                                        Style="{StaticResource DangerButtonStyle}"
                                                        Command="{Binding DataContext.DeleteCommand,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Padding="14,8" FontSize="12"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                </DockPanel>
            </Grid>

        </Grid>
    </Grid>
</Window>
